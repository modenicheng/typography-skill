{
  "$description": "typography-system · DTCG 0.1 交换格式。运行时以 templates/tokens.css 为准；密度（reading/compact）不在此文件展开。",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI Variable Text",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "PingFang SC",
          "Hiragino Sans GB",
          "Microsoft YaHei",
          "Noto Sans CJK SC",
          "Source Han Sans SC",
          "sans-serif"
        ]
      },
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Source Serif 4",
          "Noto Serif SC",
          "Source Han Serif SC",
          "Songti SC",
          "SimSun",
          "serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "SF Mono",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "Noto Sans Mono CJK SC",
          "monospace"
        ]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "size": {
    "display": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
    "page": { "$type": "dimension", "$value": { "value": 1.75, "unit": "rem" } },
    "section": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "body": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "label": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
    "caption": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } }
  },
  "leading": {
    "$description": "无单位行高。中文比英文松 0.15–0.25。",
    "display": { "$type": "number", "$value": 1.1667 },
    "page": { "$type": "number", "$value": 1.4286 },
    "section": { "$type": "number", "$value": 1.5 },
    "body": { "$type": "number", "$value": 1.75 },
    "label": { "$type": "number", "$value": 1.5714 },
    "caption": { "$type": "number", "$value": 1.5 }
  },
  "leadingEn": {
    "$description": "英文主语言页面的行高覆盖。",
    "display": { "$type": "number", "$value": 1.0833 },
    "page": { "$type": "number", "$value": 1.2857 },
    "section": { "$type": "number", "$value": 1.4 },
    "body": { "$type": "number", "$value": 1.5 },
    "label": { "$type": "number", "$value": 1.4286 },
    "caption": { "$type": "number", "$value": 1.3333 }
  },
  "tracking": {
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } },
    "tight": { "$type": "dimension", "$value": { "value": -0.02, "unit": "em" } },
    "caps": { "$type": "dimension", "$value": { "value": 0.06, "unit": "em" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "12": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
    "16": { "$type": "dimension", "$value": { "value": 4, "unit": "rem" } }
  },
  "text": {
    "zh": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.display}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{leading.display}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "page": {
        "$type": "typography",
        "$description": "每页一个；display 仅品牌/营销页面使用",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.page}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{leading.page}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.section}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{leading.section}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "body": {
        "$type": "typography",
        "$description": "正文；中文行高 1.75，英文页面覆盖为 1.5",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.body}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{leading.body}",
          "letterSpacing": "{tracking.none}"
        },
        "$extensions": {
          "org.typography-system.css": {
            "sizeVariable": "--text-body-size",
            "leadingVariable": "--text-body-leading"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.label}",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": "{leading.label}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.caption}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{leading.caption}",
          "letterSpacing": "{tracking.none}"
        }
      }
    },
    "en": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.display}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{leadingEn.display}",
          "letterSpacing": "{tracking.tight}"
        }
      },
      "page": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.page}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{leadingEn.page}",
          "letterSpacing": "{tracking.tight}"
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.section}",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "{leadingEn.section}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.body}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{leadingEn.body}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.label}",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": "{leadingEn.label}",
          "letterSpacing": "{tracking.none}"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{size.caption}",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "{leadingEn.caption}",
          "letterSpacing": "{tracking.caps}"
        }
      }
    }
  }
}
